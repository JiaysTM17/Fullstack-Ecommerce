# ============================================================
# Mini Shopee Enterprise — Environment Configuration
# ============================================================
# Copy file này thành .env và điền giá trị phù hợp
# cp .env.example .env

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB connection string (nếu không kết nối được sẽ tự động dùng In-Memory Store)
MONGO_URI=mongodb://127.0.0.1:27017/mini-shopee

# --- Client ---
# Frontend URL cho CORS (phân cách bằng dấu phẩy nếu nhiều origins)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# --- Authentication ---
# JWT Secret Key (BẮT BUỘC đổi cho production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Logging ---
# Log level: ERROR | WARN | INFO | DEBUG
LOG_LEVEL=DEBUG
