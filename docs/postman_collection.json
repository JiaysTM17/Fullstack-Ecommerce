            "url": {
              "raw": "{{baseUrl}}/api/seller/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "seller", "orders"]
            }
          }
        },
        {
          "name": "Update Order Status (Dispatch Order)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipping\",\n  \"carrier\": \"SPX Express\",\n  \"trackingCode\": \"SPX99182741VN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/seller/orders/order_1/status",
