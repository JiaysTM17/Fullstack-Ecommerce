    {
      "name": "5. Orders & Checkout",
      "item": [
        {
          "name": "Get Customer Order History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "my-orders"]
            }
          }
        },
        {
          "name": "Create New Order (Checkout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"prod_1\",\n      \"title\": \"Áo Thun Basic Cotton 100%\",\n      \"price\": 149000,\n      \"quantity\": 2,\n      \"shopId\": \"shop_1\"\n    }\n  ],\n  \"subtotal\": 298000,\n  \"shippingFee\": 30000,\n  \"discount\": 20000,\n  \"coinUsed\": 10000,\n  \"totalAmount\": 298000,\n  \"paymentMethod\": \"cod\",\n  \"shippingAddress\": {\n    \"fullName\": \"Kiệt Trương\",\n    \"phone\": \"0987654321\",\n    \"address\": \"123 Đường Nguyễn Huệ, Quận 1, TP.HCM\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Seller Operations",
      "item": [
        {
          "name": "Get Seller Store Orders",
          "request": {
            "method": "GET",
            "header": [
