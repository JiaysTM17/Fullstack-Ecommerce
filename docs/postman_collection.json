          }
        },
        {
          "name": "Validate Voucher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"GIAM20K\",\n  \"subtotal\": 350000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vouchers", "validate"]
            }
          }
