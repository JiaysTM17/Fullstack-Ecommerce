    {
      "name": "2. Products",
      "item": [
        {
          "name": "Get All Products (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&limit=20&sort=popular",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "sort", "value": "popular" }
              ]
            }
          }
        },
        {
          "name": "Get Product Detail by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/prod_1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "prod_1"]
            }
          }
        },
        {
          "name": "Search Products by Keyword",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?q=áo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "q", "value": "áo" }
              ]
            }
          }
        }
      ]
    },
